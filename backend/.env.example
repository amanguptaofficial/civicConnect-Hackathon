# Server Configuration
PORT=5000
NODE_ENV=development
# Database Configuration
MONGODB_URI=mongodb://localhost:27017/civicconnect
# Frontend Configuration
FRONTEND_URL=http://localhost:3000
# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=24h
# OpenAI Configuration (Optional - for AI features)
OPENAI_API_KEY=your-openai-api-key-here
# Cloudflare R2 Storage Configuration (Optional - for file uploads)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_REGION=auto
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=your-custom-domain.com
R2_PUBLIC_URL=https://your-custom-domain.com
# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,text/plain
# Security
BCRYPT_ROUNDS=12
# Logging
LOG_LEVEL=info
# Analytics (Optional)
ANALYTICS_ENABLED=true
# Development Settings
DEBUG=civicconnect:*
